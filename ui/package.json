{
	"name": "@base/ui",
	"version": "0.0.1",
	"description": "Vendored shadcn/base-ui primitives, a tiptap v3 rich text editor, and the useAppForm-based form field system baseConfig renders every field through.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/phe-rus/base-config.git",
		"directory": "ui"
	},
	"homepage": "https://github.com/phe-rus/base-config#readme",
	"bugs": {
		"url": "https://github.com/phe-rus/base-config/issues"
	},
	"keywords": [
		"ui",
		"shadcn",
		"tiptap",
		"forms",
		"tanstack-form"
	],
	"private": false,
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		"./basiccn": {
			"types": "./dist/basiccn/index.d.ts",
			"default": "./dist/basiccn/index.js"
		},
		"./basiccn/preview": {
			"types": "./dist/basiccn/preview.d.ts",
			"default": "./dist/basiccn/preview.js"
		},
		"./forms": {
			"types": "./dist/forms/index.d.ts",
			"default": "./dist/forms/index.js"
		},
		"./tables": {
			"types": "./dist/tables/index.d.ts",
			"default": "./dist/tables/index.js"
		},
		"./image": {
			"types": "./dist/image/index.d.ts",
			"default": "./dist/image/index.js"
		},
		"./components/*": {
			"types": "./dist/components/*.d.ts",
			"default": "./dist/components/*.js"
		},
		"./lib/*": {
			"types": "./dist/lib/*.d.ts",
			"default": "./dist/lib/*.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/state": "^6.1.1",
		"@codemirror/view": "^6.0.0",
		"@tabler/icons-react": "^3.45.0",
		"@tanstack/react-table": "latest",
		"@tiptap/core": "^3.27.4",
		"@tiptap/extension-blockquote": "^3.27.4",
		"@tiptap/extension-bold": "^3.27.4",
		"@tiptap/extension-code": "^3.28.0",
		"@tiptap/extension-code-block": "^3.27.4",
		"@tiptap/extension-code-block-lowlight": "^3.28.0",
		"@tiptap/extension-document": "^3.27.4",
		"@tiptap/extension-drag-handle-react": "^3.28.0",
		"@tiptap/extension-hard-break": "^3.27.4",
		"@tiptap/extension-heading": "^3.27.4",
		"@tiptap/extension-highlight": "^3.27.4",
		"@tiptap/extension-horizontal-rule": "^3.27.4",
		"@tiptap/extension-image": "^3.28.0",
		"@tiptap/extension-italic": "^3.27.4",
		"@tiptap/extension-link": "^3.27.4",
		"@tiptap/extension-list": "^3.27.4",
		"@tiptap/extension-paragraph": "^3.27.4",
		"@tiptap/extension-strike": "^3.27.4",
		"@tiptap/extension-subscript": "^3.28.0",
		"@tiptap/extension-superscript": "^3.28.0",
		"@tiptap/extension-table": "^3.28.0",
		"@tiptap/extension-text": "^3.27.4",
		"@tiptap/extension-text-align": "^3.28.0",
		"@tiptap/extension-text-style": "^3.27.4",
		"@tiptap/extension-typography": "^3.28.0",
		"@tiptap/extension-underline": "^3.27.4",
		"@tiptap/extensions": "^3.27.4",
		"@tiptap/pm": "^3.27.4",
		"@tiptap/react": "^3.27.4",
		"@tiptap/suggestion": "^3.27.4",
		"@uiw/react-codemirror": "^4.25.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"goey-toast": "^0.5.0",
		"lowlight": "^3.3.0",
		"react-day-picker": "^10.0.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"tsdown": "latest",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"@tanstack/react-form": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"react": ">=19",
		"react-dom": ">=19",
		"typescript": ">=5"
	}
}
