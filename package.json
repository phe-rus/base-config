{
	"name": "base-config",
	"version": "0.0.0",
	"description": "baseConfig: a config-driven, edge-native CMS engine for TanStack Start on Cloudflare Workers.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/phe-rus/base-config.git"
	},
	"homepage": "https://github.com/phe-rus/base-config#readme",
	"bugs": {
		"url": "https://github.com/phe-rus/base-config/issues"
	},
	"private": true,
	"workspaces": [
		"packages/*",
		"plugins/*",
		"templates/*"
	],
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev --filter=!@baseconfig/cli",
		"typecheck": "turbo typecheck",
		"format": "biome format --write .",
		"lint": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"turbo": "^2.10.8",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.3.14"
}
