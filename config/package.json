{
	"name": "@base/config",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./admin": {
			"types": "./dist/admin/index.d.mts",
			"default": "./dist/admin/index.mjs"
		},
		"./api": {
			"types": "./dist/api/index.d.mts",
			"default": "./dist/api/index.mjs"
		},
		"./api/*": {
			"types": "./dist/api/*.d.mts",
			"default": "./dist/api/*.mjs"
		},
		"./*": {
			"types": "./dist/*.d.mts",
			"default": "./dist/*.mjs"
		}
	},
	"bin": {
		"base": "./dist/cli.mjs"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"tsdown": "latest",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@base/ui": "workspace:*",
		"@hono/zod-validator": "^0.9.0",
		"@tabler/icons-react": "^3.45.0",
		"@tanstack/query-db-collection": "^1.2.1",
		"@tanstack/react-db": "latest",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^1.0.0-rc.4",
		"nanoid": "^6.0.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "latest",
		"@tanstack/react-store": "^0.11.0",
		"@types/react": "^19",
		"hono": "^4",
		"react": ">=19",
		"typescript": ">=5"
	}
}
