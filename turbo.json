{
	"$schema": "https://v2-10-8.turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"type-gen": {
			"dependsOn": ["^type-gen"],
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["type-gen"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"cache": false
		}
	}
}
