{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "baseconfig",
	"compatibility_date": "2026-07-10",
	"main": "./src/server.ts",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		// Without this, any request matching a prerendered static file
		// (`/`, `/docs`, `/docs/`, `/roadmap`, ...) is served straight from
		// the asset store and never reaches the Worker at all, real, empirically
		// confirmed: publishing a new doc or editing the topbar/category
		// globals had zero effect on these pages until the next `bun run
		// build && bun run deploy` re-baked the static file, completely
		// bypassing `server.ts`'s own edge-cache/`Cache-Control` logic (and
		// the purge-on-publish hooks that depend on it, `config/api/revalidate.ts`).
		// Listed explicitly rather than `true`: hashed JS/CSS/image assets
		// under `/assets/*` should still be served directly with zero Worker
		// invocation, only these content/global-backed page routes need to
		// run fresh every request.
		"run_worker_first": [
			"/",
			"/docs",
			"/docs/",
			"/roadmap"
		],
	},
	"placement": {
		"mode": "smart",
	},
	"cache": {
		"enabled": true,
	},
	"observability": {
		"enabled": false
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"custom_domain": true,
			"pattern": "baseconfig.pherus.org"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "74165d1466c74e17a4b41470f956de49"
		},
	],
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "baseconfig",
			"database_id": "61c58069-8c86-4d5a-8686-a3e75224b9d4",
			"migrations_dir": "./.migrations",
			"migrations_pattern": "./.migrations/*/migration.sql"
		},
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "baseconfig"
		},
	],
}