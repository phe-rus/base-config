{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "baseconfig",
	"compatibility_date": "2026-07-10",
	"main": "./src/server.ts",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"placement": {
		"mode": "smart",
	},
	"cache": {
		"enabled": true,
	},
	"observability": {
		"enabled": false
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"custom_domain": true,
			"pattern": "baseconfig.pherus.org"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "74165d1466c74e17a4b41470f956de49"
		},
	],
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "baseconfig",
			"database_id": "61c58069-8c86-4d5a-8686-a3e75224b9d4",
			"migrations_dir": "./.migrations",
			"migrations_pattern": "./.migrations/*/migration.sql"
		},
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "baseconfig"
		},
	],
	// Self-reference: lets SSR read its own content (`base.find`/`findGlobal`,
	// via `baseConfig({fetcher: ...})`, `src/config/base.config.ts`) through
	// `env.SELF.fetch(...)` instead of a real `fetch()` back to this Worker's
	// own public custom domain, which Cloudflare doesn't route reliably for a
	// Worker calling itself (confirmed via a real production 522/`<!DOCTYPE>`
	// incident). A Service binding is same-thread, no DNS/TLS, no public
	// network hop at all.
	"services": [
		{
			"binding": "SELF",
			"service": "baseconfig"
		},
	],
}